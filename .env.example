# Supabase — House of Avenya
# Copy this file to .env.local and fill in the real values.
# Never commit .env.local or any file containing real secrets.

# Project URL (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://fyfbxtzjvjzmbzprubiy.supabase.co

# Publishable / anonymous key (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SECRET — server/migration only, never shipped to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay — TEST MODE ONLY
# Get these from Razorpay Dashboard → Settings → API Keys (Test Mode)
# RAZORPAY_KEY_ID is public and safe to expose in the browser bundle
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# RAZORPAY_KEY_SECRET is SECRET — server-side only, never shipped to the client
# Do NOT prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_secret_here